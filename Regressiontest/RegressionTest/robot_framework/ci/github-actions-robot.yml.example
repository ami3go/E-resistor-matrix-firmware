name: E-Resistor Robot Validation

on:
  push:
  pull_request:

jobs:
  robot-dryrun:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install -r requirements-robot.txt
      - run: python -m pip install -e .
      - run: python robot_framework/ci/validate_robot_suites.py
